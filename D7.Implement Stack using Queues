class MyStack:

    def __init__(self):
        self.queue = []
        self.high = -1

    def push(self, x: int) -> None:
        self.queue.append(x)
        self.high += 1

    def pop(self) -> int:
        if self.high == -1:
            return 0
        
        num = self.queue[self.high]
        self.queue.pop(self.high)
        self.high -= 1
        return num

    def top(self) -> int:
        if self.high == -1:
            return 0
        return self.queue[self.high]

    def empty(self) -> bool:
        return self.high == -1
