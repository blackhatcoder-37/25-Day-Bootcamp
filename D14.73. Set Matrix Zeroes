from typing import List

class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        """
        Do not return anything, modify matrix in-place instead.
        """
        ROWS, COLS = len(matrix), len(matrix[0])
        first_row_has_zero = False
        first_col_has_zero = False
        
        # 1. Check if the first row or first column contains any zeros
        for c in range(COLS):
            if matrix[0][c] == 0:
                first_row_has_zero = True
                break
                
        for r in range(ROWS):
            if matrix[r][0] == 0:
                first_col_has_zero = True
                break
        
        # 2. Use the first row and first column to mark zeros for the rest of the matrix
        for r in range(1, ROWS):
            for c in range(1, COLS):
                if matrix[r][c] == 0:
                    matrix[0][c] = 0
                    matrix[r][0] = 0
        
        # 3. Zero out cells based on the marks in the first row and column
        for r in range(1, ROWS):
            for c in range(1, COLS):
                if matrix[0][c] == 0 or matrix[r][0] == 0:
                    matrix[r][c] = 0
        
        # 4. Finally, zero out the first row if needed
        if first_row_has_zero:
            for c in range(COLS):
                matrix[0][c] = 0
                
        # 5. Finally, zero out the first column if needed
        if first_col_has_zero:
            for r in range(ROWS):
                matrix[r][0] = 0
